# Postgres (Neon) connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Housecall Pro
HCP_API_KEY=""
HCP_WEBHOOK_SIGNING_SECRET=""

# Working hours (used by the availability engine until this moves to admin config)
BUSINESS_HOURS_START="08:00"
BUSINESS_HOURS_END="18:00"
# IANA time zone the business hours above are in. Servers run in UTC, so this must be explicit.
BUSINESS_TIMEZONE="America/Chicago"

# Protects /api/admin/hcp-sync (the HCP backfill). Any long random text, e.g. from: openssl rand -hex 16
# Leave empty to disable that route entirely.
ADMIN_SYNC_SECRET=""

# Password for the Admin screen (/admin), where you choose who takes residential / commercial calls.
# Use something long and random, e.g. from: openssl rand -base64 18
# Leave empty to switch the Admin screen off entirely.
ADMIN_PASSWORD=""

# Automatic refresh: keeps the schedule current without anyone running a command. It runs on a server that
# stays running (your computer, a VPS). On serverless hosting nothing stays running, so use a scheduled call
# instead (see "Keeping the schedule fresh" in the README).
# Minutes between refreshes. Default 10. Use 0 or "off" to turn it off. It is never faster than 5, because the
# free Neon database sleeps after 5 idle minutes and has a monthly compute allowance (100 CU-hours): a faster
# timer would keep it awake all day.
AUTO_SYNC_MINUTES="10"
# The hours (in BUSINESS_TIMEZONE) when it runs, like 6-19 = 6:00 AM up to 7:00 PM. Outside them it pauses so the
# free database can sleep overnight.
AUTO_SYNC_HOURS="6-19"
# The console warns when the schedule is older than this many minutes. Leave empty to choose automatically
# (twice the refresh time, at least 15 minutes).
STALE_AFTER_MINUTES=""

# Job Watch: the desktop panel shows an alert when a technician has been on a job longer than normal, counted from
# when they tapped Start in the Housecall Pro app. An INSTALL is checked once it has run this many minutes...
JOB_WATCH_INSTALL_MINUTES="90"
# ...and any other (service) work once it has run this many.
JOB_WATCH_SERVICE_MINUTES="60"
# A job counts as an install when its type, tags, business unit, name, description or line items contain one of these
# words (comma separated, any capitalisation). Run scripts/hcp-jobwatch-probe.mjs to see how YOUR jobs are labeled.
JOB_WATCH_INSTALL_WORDS="install"

# Job Watch also announces a job a tech has just FINISHED (tapped Finish), with the job's notes, for this many hours
# (1 to 12) after the tap. Nothing is kept: the panel shows each one until someone clicks it away.
JOB_WATCH_COMPLETED_HOURS="3"
# The notes can contain customer details (a gate code, a name). Set this to "off" to announce finished jobs WITHOUT
# their notes (for example before the console is put online without a login).
JOB_WATCH_SHOW_NOTES="on"

# "Go to job" button on the pop-up bars. {id} is replaced with the job id. Only https links are used, and the panel only
# opens Housecall Pro addresses. Leave this out unless Housecall Pro changes its job address.
# HCP_JOB_URL_TEMPLATE="https://pro.housecallpro.com/app/jobs/{id}"

# Sign-in for the dispatcher screen and its data (everything except the Admin screen, which has its own password).
# Use something long and random, e.g. from: openssl rand -base64 18
# On your own computer, leave it empty and the console stays open like before.
# On hosting (Vercel) an empty value LOCKS the console completely, so forgetting it can never leave it open.
# Changing it signs everyone out.
CONSOLE_PASSWORD=""

# Lets an outside scheduler start the refresh by calling  /api/cron/sync  with the header
#   Authorization: Bearer <this value>
# Any long random text, e.g. from: openssl rand -hex 16.  Leave empty to switch that route off.
# It only refreshes inside AUTO_SYNC_HOURS, so the free database can sleep overnight.
CRON_SECRET=""

# ---- Estimate Tracker (the Estimates tab, and estimate pop-ups in the panel) ----
# Pop-up when a TECH finishes an estimate in the field (shows the options and amounts), announced for this many hours.
# ESTIMATE_FINISHED_HOURS="3"
# Pop-up when an estimate made at the OFFICE (no tech tapped Start/Finish) has no approved/pro approved/declined/pro declined
# option after this many days (an "expired" option does not count as an answer), and stops after the second number of days.
# ESTIMATE_WAIT_DAYS="3"
# ESTIMATE_WAIT_MAX_DAYS="14"
# The Estimates tab lists this year's estimates whose option carries ALL of these tags (case does not matter), comma separated.
# ESTIMATE_LIST_TAGS="Jasen Est,*"
# First day of the list and the numbers (YYYY-MM-DD). Leave out for 1 January of the current year.
# ESTIMATE_LIST_FROM="2026-01-01"
# Show customer names on the Estimates tab. Off by default; the pop-ups never carry them.
# ESTIMATE_SHOW_CUSTOMER="off"
# The "Go to estimate" button. {id} is replaced by the estimate id. Only https links are used.
# HCP_ESTIMATE_URL_TEMPLATE="https://pro.housecallpro.com/app/estimates/{id}"

# ---- Phone notifications (Admin screen > Phone notifications) ----
# Sent through ntfy, a free push service: each person subscribes once on their phone to their own private channel.
# Leave these out to use the free public server. Only set them if you run your own ntfy server.
# NTFY_SERVER="https://ntfy.sh"
# NTFY_TOKEN=""
# The scheduled sender needs CRON_SECRET (the same one as the scheduled refresh) and a second cron-job.org job that calls
#   GET https://YOUR-APP/api/cron/notify   with the header   Authorization: Bearer <CRON_SECRET>   every 2 minutes.
# It only works inside AUTO_SYNC_HOURS, like the refresh.

