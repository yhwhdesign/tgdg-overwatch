{
  "manifest_version": 3,
  "name": "TGDG Overwatch",
  "version": "1.0.0",
  "description": "Docked panel for The Garage Door Guy Corp dispatch tools.",
  "action": {
    "default_title": "Open Overwatch"
  },
  "background": {
    "service_worker": "background-chrome.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
