{
  "manifest_version": 3,
  "name": "TGDG Overwatch",
  "version": "1.0.0",
  "description": "Docked panel for The Garage Door Guy Corp dispatch tools.",
  "sidebar_action": {
    "default_title": "TGDG Overwatch",
    "default_panel": "sidepanel.html",
    "open_at_install": false
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tgdg-overwatch@thegaragedoorguycorp.com"
    }
  }
}
