{
  "name": "tgdg-overwatch",
  "version": "1.0.0",
  "private": true,
  "description": "Docked desktop panel for The Garage Door Guy Corp dispatch tools \u2014 pins to the screen edge alongside any browser.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.thegaragedoorguycorp.overwatch",
    "productName": "TGDG Overwatch",
    "files": ["src/**/*"],
    "directories": { "output": "release" },
    "mac": { "identity": null, "target": "dir" },
    "win": { "target": "portable" },
    "linux": { "target": "AppImage" }
  }
}
